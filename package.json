{
  "name": "streamchat",
  "version": "1.0.3",
  "description": "A simple real-time chat overlay for Tiktok, Youtube Streams, made for OBS. It's built with Python (Flask) and WebSockets, and just connects to a public stream to show chat, gifts, likes, and viewer count.",
  "main": "main.js",
  "scripts": {
    "clean": "npx rimraf release dist-ts",
    "prebuild:ts": "npm run clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dev": "electron .",
    "build:ts": "npx esbuild server.ts --bundle --platform=node --target=node18 --outfile=dist-ts/server.js --external:tiktok-live-connector --external:youtube-chat",
    "dist": "npm run build:ts && electron-builder --dir",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.asmodeus.streamchat",
    "productName": "StreamChat",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "dist-ts/**/*",
      "static/**/*",
      "templates/**/*"
    ],
    "win": {
      "icon": "icon.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asmodeus7999/StreamChatOverlay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Asmodeus7999/StreamChatOverlay/issues"
  },
  "homepage": "https://github.com/Asmodeus7999/StreamChatOverlay#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tiktok-live-connector": "^2.4.4",
    "youtube-chat": "^2.2.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}